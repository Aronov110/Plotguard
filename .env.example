# Copy to .env and adjust. Never commit .env.

# Required, no default: development, test or production. Production turns on the Secure cookie flag
# and the https-only CORS rule, so a missing value must stop the app instead of switching them off.
NODE_ENV=development

# Auth. JWT_ACCESS_SECRET signs the short-lived access tokens: at least 32 characters, never shared,
# never committed. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# The placeholder below is public, so the app refuses to start with it (only the tests accept it):
# replace it with a generated value before the first start. It also refuses secrets that repeat a
# few characters.
JWT_ACCESS_SECRET=change-me-generate-a-real-one-before-using-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# A refresh token used twice within this many seconds is refused but not treated as stolen.
REFRESH_REUSE_GRACE_SECONDS=10

# API
API_HOST=127.0.0.1
API_PORT=3000

# Browser origins allowed to call the API (comma-separated, exact scheme://host[:port], no wildcard).
# Optional in development (defaults to the Vite dev server). Required when NODE_ENV=production,
# where every origin must use https://.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Per-client rate limit: at most RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# Database (matches docker-compose.yml)
POSTGRES_USER=plotpal
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=plotpal
POSTGRES_PORT=5432
DATABASE_URL=postgres://plotpal:change-me-locally@127.0.0.1:5432/plotpal

# Integration tests only. The database name MUST end in _test: tests wipe its tables.
TEST_DATABASE_URL=postgres://plotpal:change-me-locally@127.0.0.1:5432/plotpal_test

# AI features (plot-hole finder, idea generator). Optional: without a key they are switched off and
# everything else works. Create a key in the Anthropic Console and paste it after the equals sign.
# The key stays on the server: never commit .env, and never put the key in the web app.
ANTHROPIC_API_KEY=
# false switches the AI features off even when a key is set.
AI_ENABLED=true
# The plain model name, with no date (for example claude-sonnet-5-5 for a cheaper, faster run).
AI_MODEL=claude-opus-5-5
# How hard the model thinks: low, medium, high, xhigh or max. Higher costs more.
AI_EFFORT=high
# The longest text one run may send, and the most the model may write, in tokens.
AI_MAX_INPUT_TOKENS=200000
AI_MAX_OUTPUT_TOKENS=24000
# One person's limits over the last 24 hours, and everybody's tokens together (the cap on the bill).
AI_USER_DAILY_RUNS=10
AI_USER_DAILY_TOKENS=1000000
AI_GLOBAL_DAILY_TOKENS=5000000
# How long one run may take before it is given up.
AI_REQUEST_TIMEOUT_SECONDS=600
