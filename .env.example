# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=3000

# Browser origins allowed to call the API (comma-separated, exact scheme://host[:port], no wildcard).
# Optional in development (defaults to the Vite dev server). Required when NODE_ENV=production,
# where every origin must use https://.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Per-client rate limit: at most RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# Database (matches docker-compose.yml)
POSTGRES_USER=plotpal
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=plotpal
POSTGRES_PORT=5432
DATABASE_URL=postgres://plotpal:change-me-locally@127.0.0.1:5432/plotpal

# Integration tests only. The database name MUST end in _test: tests wipe its tables.
TEST_DATABASE_URL=postgres://plotpal:change-me-locally@127.0.0.1:5432/plotpal_test
